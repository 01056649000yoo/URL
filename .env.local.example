SITE_URL=http://localhost:3000
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
ADMIN_EMAIL=admin@example.com
# cleanup 스케줄러(/api/cleanup-expired) 인증용 공유 토큰
SHORTENER_ADMIN_TOKEN=replace-with-a-long-random-secret
RATE_LIMIT_SALT=samlink-rate-limit-v1
# 로컬 개발은 프록시가 없으므로 false, 운영(맥미니, jarvis-tunnel 경유)은 true
TRUST_PROXY_HEADERS=false
# (현재 미사용) 전용 터널을 새로 만들 때만 필요 — docs/cloudflare-tunnel-setup.md 참고
# TUNNEL_TOKEN=
# Google Safe Browsing API 키 — 설정하면 링크 생성 시 피싱·멀웨어 목적지를 차단 (비우면 검사 생략)
GOOGLE_SAFE_BROWSING_API_KEY=
# 기기 쿠키(내 링크 소유권) 서명 전용 키 — DB 마스터 키와 분리하려면 설정 (미설정 시 SERVICE_ROLE_KEY로 대체)
DEVICE_COOKIE_SECRET=
