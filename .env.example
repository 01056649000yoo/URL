SITE_URL=https://샘링크.kr
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=admin@example.com
# cleanup 스케줄러(/api/cleanup-expired) 인증용 공유 토큰
SHORTENER_ADMIN_TOKEN=
RATE_LIMIT_SALT=samlink-rate-limit-v1
# Cloudflare(터널·프록시) 뒤에서 서비스할 때 true — 현재 운영 환경은 jarvis-tunnel 경유이므로 true
TRUST_PROXY_HEADERS=true
# (현재 미사용) 전용 터널을 새로 만들 때만 필요 — docs/cloudflare-tunnel-setup.md 참고
# TUNNEL_TOKEN=

# Manual deploy on Mac mini
# git pull
# docker compose --env-file .env.local up -d --build
