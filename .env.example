SITE_URL=https://샘링크.kr
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=admin@example.com
# cleanup 스케줄러(/api/cleanup-expired) 인증용 공유 토큰
SHORTENER_ADMIN_TOKEN=
RATE_LIMIT_SALT=samlink-rate-limit-v1
# Cloudflare 뒤에서 서비스할 때 true (docs/cloudflare-tunnel-setup.md 참고)
TRUST_PROXY_HEADERS=false
# Cloudflare Tunnel 연결 토큰 (docs/cloudflare-tunnel-setup.md 1단계에서 발급)
TUNNEL_TOKEN=

# Manual deploy on Mac mini
# git pull
# docker compose --env-file .env.local up -d --build
